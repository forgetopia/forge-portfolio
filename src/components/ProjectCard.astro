---
import type { CollectionEntry } from 'astro:content';
import Arrow from './Arrow.astro';
import { categoryLabel, projectHref } from '../lib/projects';
import '../styles/portfolio.css';
import '../styles/card-previews.css';

interface Props {
  project: CollectionEntry<'projects'>;
  headingLevel?: 'h2' | 'h3';
}

const { project, headingLevel = 'h3' } = Astro.props;
const { title, summary, cover, categories, sample, previewVideo } = project.data;
const Heading = headingLevel;
---

<article
  class:list={['project-card', `project-card--${cover.orientation}`]}
  data-project-card
  data-slug={project.data.slug}
  data-categories={categories.join(' ')}
  data-preview-state={previewVideo ? 'idle' : undefined}
>
  <a class="project-card-link" href={projectHref(project.data.slug)} aria-label={`View project: ${title}`}>
    <div class="project-card-media" style={`--project-media-ratio: ${cover.width} / ${cover.height};`}>
      <img
        src={cover.src}
        alt={cover.alt}
        width={cover.width}
        height={cover.height}
        loading="lazy"
        decoding="async"
      />
      {previewVideo && <>
        <video
          class="project-card-preview"
          data-card-preview
          data-src={previewVideo.src}
          data-type={previewVideo.type}
          data-placeholder={String(previewVideo.placeholder)}
          width={previewVideo.width}
          height={previewVideo.height}
          preload="none"
          muted
          loop
          playsinline
          aria-hidden="true"
          tabindex="-1"
        ></video>
        <span class="project-preview-label" aria-hidden="true" data-card-preview-status hidden></span>
      </>}
      {cover.placeholder && <span class="project-media-label">Placeholder image</span>}
      <span class="project-card-open" aria-hidden="true"><Arrow /></span>
    </div>
    <div class="project-card-caption">
      <p class="eyebrow">{categories.map(categoryLabel).join(' / ')}</p>
      <Heading>{title}</Heading>
      <p class="project-card-summary">{summary}</p>
      {sample && <span class="project-sample-label">Sample project</span>}
    </div>
  </a>
</article>

<script>
  import { initCardPreviews } from '../scripts/card-previews';

  initCardPreviews();
</script>
