---
import type { ImageData, VideoData } from '../lib/project-schema';
import '../styles/project-media.css';

interface Props {
  video: VideoData;
  poster: ImageData;
  title: string;
}

const { video, poster, title } = Astro.props;
---

<section class="project-film-section" aria-labelledby="project-film-heading">
  <div class="section-heading">
    <div><p class="eyebrow">Motion & narrative</p><h2 id="project-film-heading">The <em>film.</em></h2></div>
    {video.placeholder && <span class="media-kind-label">Placeholder clip{!video.hasAudio && ' · Silent test footage'}</span>}
  </div>
  <figure class:list={['project-player', `project-player--${video.orientation}`]} style={`--film-ratio: ${video.width} / ${video.height};`} data-project-player data-player-state="idle">
    <div class="project-player-frame" style={`--film-ratio: ${video.width} / ${video.height};`}>
      <img class="project-player-poster" data-player-poster src={poster.src} alt={poster.alt} width={poster.width} height={poster.height} loading="lazy" hidden />
      <video
        data-project-video
        src={video.src}
        poster={poster.src}
        width={video.width}
        height={video.height}
        controls
        tabindex="0"
        playsinline
        crossorigin={video.src.startsWith('https://') || video.captions.some((caption) => caption.src.startsWith('https://')) ? 'anonymous' : undefined}
        preload="none"
        aria-label={`${title} — project film`}
        aria-describedby="project-film-note"
      >
        {video.captions.map((caption, index) => <track kind="captions" src={caption.src} srclang={caption.srclang} label={caption.label} default={index === 0} />)}
        <p>Your browser cannot play this video. <a href={video.src}>Open the film file</a>.</p>
      </video>
      <div class="project-player-overlay" data-player-overlay hidden>
        <button type="button" class="film-play-button" data-player-start aria-label={`Play film: ${title}`} data-film-title={title}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m8 5 11 7-11 7Z" fill="currentColor" /></svg>
          <span data-player-action>Play film</span>
        </button>
      </div>
    </div>
    <figcaption id="project-film-note">{video.placeholder ? 'Placeholder clip. Original film footage has not been supplied.' : 'Use the player controls to watch the film and enable captions.'}</figcaption>
    <div class="project-player-feedback">
      <p data-player-status role="status" aria-live="polite" aria-atomic="true"></p>
      <button type="button" class="text-link" data-player-retry hidden>Retry video <span aria-hidden="true">↻</span></button>
    </div>
    {video.transcript && <details class="media-transcript"><summary>Read the film transcript</summary><p>{video.transcript}</p></details>}
    <noscript><p class="media-noscript">If playback is unavailable, <a class="text-link" href={video.src}>open the film file</a>.</p></noscript>
  </figure>
</section>

<script>
  import { initProjectPlayers } from '../scripts/project-player';

  initProjectPlayers();
</script>
