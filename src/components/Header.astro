---
import { navigation, site } from '../data/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const currentState = (href: string) => path === href.replace(/\/$/, '') ? 'page' : path.startsWith(href) ? 'true' : undefined;
---

<header class="site-header">
  <div class="site-shell header-inner">
    <a class="wordmark" href="/" aria-label="FORGE — Home">
      <span class="wordmark-name">{site.name}<span class="wordmark-dot" aria-hidden="true">+</span></span>
      <span class="wordmark-caption">{site.tagline}</span>
    </a>
    <nav class="desktop-navigation" aria-label="Main navigation">
      {navigation.map(({ label, href }) => (
        <a href={href} aria-current={currentState(href)}>{label}</a>
      ))}
    </nav>
    <span class="header-note"><span class="status-dot"></span>Independent imagination</span>
    <details class="mobile-menu">
      <summary>
        <span>Menu</span>
        <span class="menu-glyph" aria-hidden="true"><i></i><i></i></span>
      </summary>
      <nav aria-label="Mobile navigation">
        <a href="/" aria-current={path === '/' ? 'page' : undefined}>Home</a>
        {navigation.map(({ label, href }) => (
          <a href={href} aria-current={currentState(href)}>{label}</a>
        ))}
      </nav>
    </details>
  </div>
</header>
