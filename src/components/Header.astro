---
import { navigation, site } from '../data/site';

const normalizePath = (value: string) => value.replace(/\/+$/, '') || '/';
const path = normalizePath(Astro.url.pathname);
const currentState = (href: string) => {
  const target = normalizePath(href);
  if (path === target) return 'page';
  return target !== '/' && path.startsWith(`${target}/`) ? 'true' : undefined;
};
---

<header class="site-header">
  <div class="site-shell header-inner">
    <a class="wordmark" href="/">
      <span class="wordmark-name">{site.name}<span class="wordmark-dot" aria-hidden="true">+</span></span>
      <span class="wordmark-caption">{site.tagline}</span>
    </a>
    <nav class="desktop-navigation" aria-label="Main navigation">
      {navigation.map(({ label, href }) => (
        <a href={href} aria-current={currentState(href)}>{label}</a>
      ))}
    </nav>
    <span class="header-note"><span class="status-dot"></span>Independent imagination</span>
    <details class="mobile-menu" data-mobile-menu>
      <summary aria-controls="mobile-navigation">
        <span>Menu</span>
        <span class="menu-glyph" aria-hidden="true"><i></i><i></i></span>
      </summary>
      <nav id="mobile-navigation" aria-label="Mobile navigation">
        <a href="/" aria-current={path === '/' ? 'page' : undefined}>Home</a>
        {navigation.map(({ label, href }) => (
          <a href={href} aria-current={currentState(href)}>{label}</a>
        ))}
      </nav>
    </details>
  </div>
</header>

<script>
  import { initMobileNavigation } from '../scripts/mobile-navigation';

  initMobileNavigation();
</script>
