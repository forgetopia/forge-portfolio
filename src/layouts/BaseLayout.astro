---
import '../styles/fonts.css';
import '@fontsource/cormorant-garamond/latin-400.css';
import '@fontsource/cormorant-garamond/latin-400-italic.css';
import displayFont from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-400-normal.woff2?url';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { showreel } from '../data/showreel';
import type { ImageData } from '../lib/project-schema';
import { pageMetadata } from '../lib/seo';

interface Props {
  title?: string;
  description?: string;
  showInvitation?: boolean;
  shareImage?: ImageData;
}

const { title, description = site.description, showInvitation = true, shareImage = site.profileImage ?? showreel.poster } = Astro.props;
const metadata = pageMetadata({ site, title, description, path: Astro.url.pathname, shareImage });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#101110" />
    <meta property="og:title" content={metadata.title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={metadata.siteName} />
    {metadata.canonical && <>
      <link rel="canonical" href={metadata.canonical} />
      <meta property="og:url" content={metadata.canonical} />
    </>}
    {metadata.imageURL && <>
      <meta property="og:image" content={metadata.imageURL} />
      <meta property="og:image:alt" content={shareImage.alt} />
      <meta property="og:image:width" content={String(shareImage.width)} />
      <meta property="og:image:height" content={String(shareImage.height)} />
      <meta name="twitter:image" content={metadata.imageURL} />
      <meta name="twitter:image:alt" content={shareImage.alt} />
    </>}
    <meta name="twitter:card" content={metadata.imageURL ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={metadata.title} />
    <meta name="twitter:description" content={description} />
    {site.productionOrigin && <link rel="sitemap" type="application/xml" href="/sitemap.xml" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <title>{metadata.title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <main id="main-content" tabindex="-1"><slot /></main>
    <Footer showInvitation={showInvitation} />
  </body>
</html>
