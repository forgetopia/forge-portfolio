---
import BaseLayout from '../layouts/BaseLayout.astro';
import Arrow from '../components/Arrow.astro';
import StudyGrid from '../components/StudyGrid.astro';
---

<BaseLayout>
  <section class="hero" aria-labelledby="hero-heading">
    <div class="hero-art" aria-hidden="true"><img src="/art/horizon.svg" alt="" width="1600" height="1100" fetchpriority="high" /></div>
    <div class="hero-vignette" aria-hidden="true"></div>
    <div class="site-shell hero-inner">
      <p class="eyebrow hero-eyebrow"><span class="small-cross" aria-hidden="true">+</span>AI filmmaking & digital art</p>
      <h1 id="hero-heading">A universe<br />in the <em>making.</em></h1>
      <p class="hero-description">At the intersection of human imagination and<br class="hidden sm:block" /> artificial possibility. Stories, worlds, and visuals<br class="hidden sm:block" /> beyond the ordinary.</p>
      <a class="button-link" href="/work/">Explore the universe <Arrow direction="right" /></a>
      <div class="hero-bottom">
        <a class="scroll-link" href="#universe"><span aria-hidden="true">↓</span>Scroll to discover</a>
        <p>001 / The beginning<span>Static visual study</span></p>
      </div>
    </div>
  </section>
  <section id="universe" class="site-shell introduction-section" aria-labelledby="intro-heading">
    <p class="eyebrow section-label">01 / The vision</p>
    <div class="introduction-copy">
      <h2 id="intro-heading">Imagination is the spark.<br /><span class="text-bronze">FORGE is where it takes form.</span></h2>
      <div class="introduction-detail">
        <p>An independent creative practice exploring the cinematic, the surreal, and the yet to be imagined. A place where technology becomes a tool for telling human stories.</p>
        <a class="text-link" href="/about/">Behind the universe <Arrow /></a>
      </div>
    </div>
  </section>
  <section class="site-shell universe-section" aria-labelledby="universe-heading">
    <div class="section-heading">
      <div><p class="eyebrow">02 / Creative territories</p><h2 id="universe-heading">One vision. <em>Infinite possibilities.</em></h2></div>
      <a class="text-link" href="/work/">Discover the work <Arrow /></a>
    </div>
    <StudyGrid />
    <p class="collection-note"><span class="status-dot"></span>The universe is taking shape. Original work coming soon.</p>
  </section>
</BaseLayout>
