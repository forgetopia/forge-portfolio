---
import PageLayout from '../layouts/PageLayout.astro';
import PortfolioGallery from '../components/PortfolioGallery.astro';
import CollectionNotice from '../components/CollectionNotice.astro';
import { getProjects } from '../lib/projects';

const projects = await getProjects();
---

<PageLayout title="Work" eyebrow="01 / The work" description="Explore FORGE's portfolio of AI films, fantasy live-action, digital art, and experimental visual worlds.">
  <Fragment slot="heading">A window into<br /><em>other worlds.</em></Fragment>
  <Fragment slot="description">Cinematic stories. Impossible landscapes. Unexpected forms.<br class="hidden sm:block" /> An evolving collection of imagination, made visible.</Fragment>
  <section class="site-shell work-section" aria-labelledby="portfolio-heading">
    <h2 id="portfolio-heading" class="sr-only">Portfolio projects</h2>
    <PortfolioGallery projects={projects} />
    <CollectionNotice projects={projects} />
  </section>
</PageLayout>
