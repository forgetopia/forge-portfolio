---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Arrow from '../../components/Arrow.astro';
import ProjectPlayer from '../../components/ProjectPlayer.astro';
import StillGallery from '../../components/StillGallery.astro';
import { categoryLabel, getProjects, projectHref } from '../../lib/projects';
import '../../styles/portfolio.css';
import '../../styles/project-media.css';

export const getStaticPaths = (async () => {
  const projects = await getProjects();

  return projects.map((project, index) => ({
    params: { slug: project.data.slug },
    props: {
      project,
      previousProject: projects.length > 1 ? projects[(index - 1 + projects.length) % projects.length] : undefined,
      nextProject: projects.length > 1 ? projects[(index + 1) % projects.length] : undefined,
    },
  }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { project, previousProject, nextProject } = Astro.props;
const { title, summary, description, categories, cover, sample, video, synopsis, creativeDirection, credits, stills } = project.data;
---

<BaseLayout title={title} description={summary}>
  <article class="site-shell project-detail">
    <a class="text-link project-back" href="/work/"><span aria-hidden="true">←</span>All works</a>
    <header class="project-detail-header">
      <p class="eyebrow">{categories.map(categoryLabel).join(' / ')}</p>
      <h1>{title}</h1>
      <p class="project-detail-summary">{summary}</p>
      {sample && <p class="project-detail-notice"><span class="status-dot"></span>Sample project · Details and category assignments are illustrative.</p>}
    </header>
    <figure class:list={['project-detail-media', `project-detail-media--${cover.orientation}`]}>
      <div class="project-detail-frame" style={`--project-media-ratio: ${cover.width} / ${cover.height};`}>
        <img src={cover.src} alt={cover.alt} width={cover.width} height={cover.height} fetchpriority="high" />
        {cover.placeholder && <span class="project-media-label">Placeholder image</span>}
      </div>
      <figcaption>{cover.placeholder ? 'Placeholder media. Original project imagery has not been provided.' : cover.alt}</figcaption>
    </figure>
    <section class="project-overview" aria-labelledby="overview-heading">
      <div><p class="eyebrow">The story</p><h2 id="overview-heading">Synopsis</h2></div>
      <div class="project-prose">{synopsis && <p>{synopsis}</p>}{description.map((paragraph) => <p>{paragraph}</p>)}</div>
    </section>
    {video && <ProjectPlayer video={video} poster={cover} title={title} />}
    {creativeDirection.length > 0 && <section class="project-direction-section" aria-labelledby="direction-heading">
      <div><p class="eyebrow">The perspective</p><h2 id="direction-heading">Creative direction</h2></div>
      <div class="project-prose">{creativeDirection.map((paragraph) => <p>{paragraph}</p>)}</div>
    </section>}
    <section class="project-credits" aria-labelledby="credits-heading">
      <p class="eyebrow">The collaborators</p><h2 id="credits-heading">Credits</h2>
      {credits.length > 0 ? <dl>{credits.map((credit) => <div><dt>{credit.role}</dt><dd>{credit.name}</dd></div>)}</dl> : <p>Verified project credits will be added here when supplied.</p>}
    </section>
    {stills.length > 0 && <StillGallery images={stills} title={title} />}
    {previousProject && nextProject && <nav class="project-pagination" aria-label="Project navigation">
      <a class="project-pagination-item" href={projectHref(previousProject.data.slug)} data-previous-project>
        <span class="eyebrow">Previous project</span><span>{previousProject.data.title}<span aria-hidden="true">←</span></span>
      </a>
      <a class="project-pagination-item" href={projectHref(nextProject.data.slug)} data-next-project>
        <span class="eyebrow">Next project</span><span>{nextProject.data.title}<Arrow /></span>
      </a>
      <a class="text-link project-pagination-back" href="/work/">Back to the collection <Arrow direction="right" /></a>
    </nav>}
  </article>
</BaseLayout>
